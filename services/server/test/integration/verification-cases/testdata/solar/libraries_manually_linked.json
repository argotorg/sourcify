        "contracts/Calculator.sol": {
          "content": "// SPDX-License-Identifier: MIT\npragma solidity ^0.8.0;\n\nlibrary MathLib {\n    function triple(uint256 x) external pure returns (uint256) {\n        return x * 3;\n    }\n}\n\ncontract Calculator {\n    function run(uint256 x) external pure returns (uint256) {\n        return MathLib.triple(x);\n    }\n}\n"
