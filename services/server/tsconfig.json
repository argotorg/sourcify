{
  "compilerOptions": {
    "allowJs": true,
    "target": "es2017",
    "sourceMap": true,
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "module": "commonjs",
    "paths": {
      "ethers": ["./node_modules/ethers"]
    },
    "skipLibCheck": true
  },
  "ts-node": {
    // With allowJs, ts-node would transpile the downloaded soljson-*.js compilers
    // (large emscripten builds), which overflows the stack for solc <0.6.2.
    // Keep ts-node's default node_modules ignore and skip the soljson files.
    "ignore": ["(?:^|/)node_modules/", "(?:^|/)soljson-[^/]*\\.js$"]
  },
  "include": ["src/**/*.ts", "src/**/*.js"],
  "exclude": ["node_modules/**"]
}
