{
  "name": "sourcify-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A Model Context Protocol (MCP) server exposing Sourcify verified-contract data (ABI, metadata, sources, verification status) to AI coding agents",
  "main": "dist/index.js",
  "bin": {
    "sourcify-mcp": "dist/index.js"
  },
  "scripts": {
    "test": "c8 --reporter=none mocha 'test/**/*.spec.ts' --exit",
    "test:live": "RUN_LIVE_TESTS=1 mocha 'test/live.spec.ts' --exit",
    "build": "tsc",
    "start": "node dist/index.js",
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"./**/*.ts\" --write",
    "fix:lint": "eslint . --ext .ts --fix",
    "check": "run-s check:*",
    "check:eslint": "eslint . --ext .ts",
    "check:prettier": "prettier \"./**/*.ts\" --check",
    "cov": "run-s -c build test cov:html cov:lcov && open-cli coverage/index.html",
    "cov:html": "c8 report --reporter=html",
    "cov:lcov": "c8 report --reporter=lcov",
    "cov:check": "c8 report && c8 check-coverage --lines 100 --functions 100 --branches 100"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/argotorg/sourcify.git"
  },
  "keywords": [
    "sourcify",
    "ethereum",
    "blockchain",
    "smart-contracts",
    "mcp",
    "model-context-protocol"
  ],
  "author": "sourcify",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/argotorg/sourcify/issues"
  },
  "homepage": "https://github.com/argotorg/sourcify#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "dotenv": "16.6.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.19.20",
    "@types/sinon": "21.0.1",
    "c8": "11.0.0",
    "chai": "4.5.0",
    "mocha": "10.8.2",
    "nock": "14.0.15",
    "open-cli": "9.0.0",
    "sinon": "21.1.2",
    "npm-run-all2": "9.0.2"
  },
  "c8": {
    "exclude": [
      "test/**"
    ],
    "reporter": [
      "html",
      "lcov",
      "text",
      "text-summary"
    ]
  }
}
